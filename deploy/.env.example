# Copy to .env (or set these as Portainer stack environment variables).
# Every variable here is explicitly declared in compose.yaml — adding a new
# one requires declaring it there too, or it never reaches the container.

# This host's WireGuard interface address. The socket proxy binds here so
# only WireGuard peers (mirarun's box) can pull the Docker read API.
MIRA_PROXY_WG_BIND=10.8.0.4

# The target reference mirarun's registry knows this host by (ADR-016),
# e.g. env://vps1/... addresses. Lowercase alphanumerics and hyphens.
MIRA_DRIVER_TARGET_REFERENCE=vps1

# movingfirm-admin collector sink. The token must match the admin stack's
# INFRA_COLLECTOR_TOKEN. URL goes over WireGuard to the admin bind.
MIRA_DRIVER_ADMIN_COLLECTOR_URL=http://10.8.0.4:6767/api/ops/infra/collector
MIRA_DRIVER_ADMIN_COLLECTOR_TOKEN=change-me

# Deployment environment label reported to admin.
MIRA_DRIVER_NODE_ENV=prod

# Poll interval.
MIRA_DRIVER_INTERVAL_SECONDS=60

# Only for hosts mirarun cannot reach directly (reachability "reported"):
# the one-time report credential returned when the target was registered.
#MIRA_DRIVER_MIRARUN_REPORT_URL=https://mirarun.example/api/target-environments/<target-id>/report
#MIRA_DRIVER_MIRARUN_REPORT_TOKEN=
